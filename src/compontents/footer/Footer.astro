---
import Logo from '../../assets/images/logo.svg';
import Image from 'astro/components/Image.astro';
import ContactItem from './ContactItem.astro';
import MediaItem from './MediaItem.astro';
import FacebookIcon from '/public/images/facebook.svg';
import TwitterIcon from '/public/images/x.svg';
import InstagramIcon from '/public/images/instagram.svg';
import type { JSX } from 'astro/jsx-runtime';
const currentPath = Astro.url.pathname;
import { contactItems } from '../../const/contact-items';
import ListItem from './ListItem.astro';

interface MediaItem {
  svg: JSX.Element;
  url: string;
}

const mediaItems: MediaItem[] = [
  {
    svg: FacebookIcon,
    url: '#',
  },
  {
    svg: TwitterIcon,
    url: '#',
  },
  {
    svg: InstagramIcon,
    url: '#',
  },
];

interface MenuItems {
  title: string;
  url: string;
}

const menuItems: MenuItems[] = [
  {
    title: 'About Us',
    url: '/about-us',
  },
  {
    title: 'Jobs',
    url: '/jobs',
  },
  {
    title: 'Press',
    url: '/press',
  },
  {
    title: 'Blog',
    url: '/blog',
  },
  {
    title: 'Contact Us',
    url: '/contact-us',
  },
  {
    title: 'Terms',
    url: '/terms',
  },
  {
    title: 'Privacy',
    url: '/privacy',
  },
]

const isHome = currentPath === '/';
---
<footer class={`bg-Navy-950 relative px-6 ${isHome ? 'pt-[260px] sm:pt-[260px]' : 'pt-[60px] sm:pt-[60px]'} pb-16 sm:p-14 `}>
  <Image src={Logo} alt='Fylo Logo' width='112' height='20' class='mb-10' />

  <div class="lg:flex lg:gap-16 justify-center">

    <div class="md:flex md:gap-20 lg:max-w-[600px]">
      <div>
        <ContactItem {...contactItems[0]} />
      </div>
      <div>
        {contactItems.slice(1,4).map((item) => <ContactItem {...item} />)}
      </div>
    </div>

    <div class="md:flex md:justify-between mt-14 lg:mt-0 lg:gap-16">
      <ul class='flex flex-col gap-4 mb-10'>
        {
          menuItems.slice(0,4).map((item) => {
            const isActive = currentPath === item.url;
            return (
              <ListItem {...item} isActive={isActive} />
            )})
        }
      </ul>
      
      <ul class='flex flex-col gap-4 mb-4'>
        <li>
          <a class='hover:text-Teal-200' href='#'>Blog</a>
        </li>
        <li>
          <a class='hover:text-Teal-200' href='#'>Contact Us</a>
        </li>
      </ul>

      <ul class='flex flex-col gap-4 mb-12'>
        <li>
          <a class='hover:text-Teal-200' href='#'>Terms</a>
        </li>
        <li>
          <a class='hover:text-Teal-200' href='#'>Privacy</a>
        </li>
      </ul>
      <ul class='flex justify-center gap-[10px]'>
        {mediaItems.map((item) => <MediaItem {...item} />)}
      </ul>

    </div>

  </div>

</footer>
