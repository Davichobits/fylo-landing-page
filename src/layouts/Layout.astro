---
import { Navbar, Footer, Header } from "../compontents";
import "../styles/global.css";
interface Props {
  title: string;
}

const { title } = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-Navy-850 text-white font-Open-Sans ">
		<main class="mx-auto">
			<Header>
				<Navbar />
			</Header>
      <slot />
			<Footer />
    </main>
	</body>
</html>